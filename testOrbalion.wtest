import orbalion.*
describe "checkpoint 1" {
    test "Un entrenador no puede tener tener un rol distinto a los autorizados por la FOZ." {
    
        const entrenador1 = new Entrenador(ciclosSolares = 1, estaSintonia = true, precision = 59, rol = "Estratega Cuantico")
        assert.throwsExceptionWithMessage("Rol no homologado por la FOZ", {entrenador1.cambiarRol("Cocinero")})
        assert.equals("Estratega Cuantico", entrenador1.rol())

    }

    test "Un equipo lumínico con radiación > 5000 y sin tecnologías activas → su energía total es su energía base." {

        const lumi1 = new Luminico(nombre="aa", nivelEnergiaBase = 10, entrenador= 2, radiacion=5002)
        assert.equals(11, lumi1.energiaTotal())

    }

    test "Un equipo lumínico con radiación < 5000 → obtiene el bono del 10%." {

        const lumi1 = new Luminico(nombre="aa", nivelEnergiaBase = 10, entrenador= 2, radiacion=4002)
        assert.equals(11, lumi1.energiaTotal())

    }

    test "Un equipo sintético con 6 módulos → aplica correctamente la penalización del 20%." {
      
        const sint1 = new Sintetico(nombre="aa", nivelEnergiaBase = 10, entrenador= 2, nivelProcesamiento=4002, modulosActivos = 6)
        assert.equals(12, sint1.energiaTotal())

    }

    test "Un equipo sintético con 4 módulos y 2 tecnologías complementarias → suma correctamente los valores energéticos" {
      
        const sint1 = new Sintetico(nombre="aa", nivelEnergiaBase = 10, entrenador= 2, nivelProcesamiento=4002, modulosActivos = 4)
        const tec1 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)
        const tec2 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)    
        
        sint1.agregarTecnologia(tec1)
        sint1.agregarTecnologia(tec2)
        assert.equals(110, sint1.energiaTotal())

    }

}

describe "checkpoint 2"{

    test "Estratega cuántico con 12 ciclos y precisión 90 → es de élite galáctica." {
        const estratega = new Entrenador(ciclosSolares = 12, precision = 90, estaSintonia = true, rol = "Estratega Cuantico")
    
        assert.that(estratega.esElite())
    
    }
    test "Arquitecto de energía con 11 ciclos pero sin sintonía → no es de élite." {
      const arquitecto = new Entrenador(ciclosSolares = 11, precision = 90, estaSintonia = false, rol = "Arquitecto de Energia")
    
        assert.notThat(arquitecto.esElite())
    }
    test "Guía mental con 15 ciclos → siempre es de élite." {
      const guia = new Entrenador(ciclosSolares = 11, precision = 90, estaSintonia = false, rol = "Guia Mental")
    
        assert.that(guia.esElite())
    }



}

describe "checkpoint 3"{
    
    test "Equipo lumínico con 3 cristales, entrenador de élite y una tecnología activa → es de prestigio universal." {
        
        const estratega = new Entrenador(ciclosSolares = 12, precision = 90, estaSintonia = true, rol = "Estratega Cuantico")
        const lumi1 = new Luminico(nombre="aa", nivelEnergiaBase = 10, entrenador= estratega, radiacion=5002)
        const tec1 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)
        const tec2 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)  
        const tec3 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)

        lumi1.agregarTecnologia(tec1)
        lumi1.agregarTecnologia(tec2)
        lumi1.agregarTecnologia(tec3)

        assert.that(lumi1.esDePrestigioUniversal())    
    }
    test "Equipo sintético certificado con 4 módulos y todas las tecnologías activas → es de prestigio." {
        const estratega = new Entrenador(ciclosSolares = 12, precision = 90, estaSintonia = true, rol = "Estratega Cuantico")
        const sint1 = new Sintetico(nombre="aa", nivelEnergiaBase = 10, entrenador= estratega, nivelProcesamiento=4002, modulosActivos = 4)
        const tec1 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)
        const tec2 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)  
        const tec3 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)
        const tec4 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)      

        sint1.agregarTecnologia(tec1)
        sint1.agregarTecnologia(tec2)
        sint1.agregarTecnologia(tec3)
        sint1.agregarTecnologia(tec4)

        assert.that(sint1.esDePrestigioUniversal())    

    }
    
    test "Equipo lumínico con 3 cristales, entrenador de élite y cero tecnologías activas → no es de prestigio universal." {
        
        const estratega = new Entrenador(ciclosSolares = 12, precision = 90, estaSintonia = true, rol = "Estratega Cuantico")
        const lumi1 = new Luminico(nombre="aa", nivelEnergiaBase = 10, entrenador= estratega, radiacion=5002)
        const tec1 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=false)
        const tec2 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=false)  
        const tec3 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=false)

        lumi1.agregarTecnologia(tec1)
        lumi1.agregarTecnologia(tec2)
        lumi1.agregarTecnologia(tec3)

        assert.notThat(lumi1.esDePrestigioUniversal())    
    }
    test "Equipo sintético certificado con 4 módulos y una tecnologia desactivada → no es de prestigio." {
        const estratega = new Entrenador(ciclosSolares = 12, precision = 90, estaSintonia = true, rol = "Estratega Cuantico")
        const sint1 = new Sintetico(nombre="aa", nivelEnergiaBase = 10, entrenador= estratega, nivelProcesamiento=4002, modulosActivos = 4)
        const tec1 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=false)
        const tec2 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)  
        const tec3 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)
        const tec4 = new TecnologiaEspecial(nombre="aa", valorEnergetico=50, activa=true)      

        sint1.agregarTecnologia(tec1)
        sint1.agregarTecnologia(tec2)
        sint1.agregarTecnologia(tec3)
        sint1.agregarTecnologia(tec4)

        assert.notThat(sint1.esDePrestigioUniversal())    

    }
}